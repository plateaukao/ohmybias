<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>OhMyBias 米 輸入法</title>
    <welcome file="welcome.html"/>
    <conclusion file="conclusion.html"/>
    <options customize="never" hostArchitectures="arm64"/>
    <allowed-os-versions><os-version min="14.0"/></allowed-os-versions>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="info.plateaukao.ohmybias.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="info.plateaukao.ohmybias.pkg" visible="false">
        <pkg-ref id="info.plateaukao.ohmybias.pkg"/>
    </choice>
    <!-- 不設 onConclusion：RequireLogout 會讓結尾只剩「登出」一顆按鈕、無法稍後再說。
         postinstall 已跑 imklaunchagent 註冊，多數情況不登出即可用；登出僅作為 conclusion 頁的建議。 -->
    <pkg-ref id="info.plateaukao.ohmybias.pkg">OhMyBiasIM-component.pkg</pkg-ref>
</installer-gui-script>
